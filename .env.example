# ─────────────────────────────────────────────────────────────────
# .env.example  —  Copy this file to `.env` and fill in your values.
# NEVER commit your real `.env` file to Git!
# ─────────────────────────────────────────────────────────────────

# ── PubMed / NCBI Entrez ─────────────────────────────────────────
# Required by NCBI's fair-use policy (allows 10 requests/sec vs 3/sec)
# Use any valid email address — no account needed.
ENTREZ_EMAIL=your_email@example.com

# Optional: Register at https://www.ncbi.nlm.nih.gov/account/ for an API key
# Allows 10 req/sec instead of 3/sec even without the email trick
NCBI_API_KEY=

# ── arXiv ────────────────────────────────────────────────────────
# arXiv API requires NO key. No variable needed.

# ── ChromaDB ─────────────────────────────────────────────────────
# Local persistence directory for the vector database
CHROMA_PERSIST_DIR=./chroma_db

# ── Embedding Model ──────────────────────────────────────────────
# Name of the sentence-transformers model to use
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Retrieval Settings ───────────────────────────────────────────
# How many top results to return from a semantic search query
TOP_K_RESULTS=5
